# Copie para .env:  cp .env.example .env
# O .env NÃO vai para o git. Este arquivo (.env.example) vai, sem segredos de verdade.

# Banco local do docker-compose (porta 5433).
DATABASE_URL="postgresql://lurdes:lurdes@localhost:5433/doces_lurdes?schema=public"

# Modo Vovó (Dev 3): senha única do painel e segredo para assinar o cookie de login.
# Gere um segredo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAINEL_SENHA="lurdes123"
PAINEL_SEGREDO="troque-por-um-segredo-longo-e-aleatorio"

# Mocks enquanto as funções reais não estão prontas. "true" = usa dados de exemplo em memória.
SITE_USAR_MOCK="false"
PAINEL_USAR_MOCK="false"

# "true" enquanto o Pix for de teste: o site mostra a faixa "não pague este Pix".
PIX_AMBIENTE_TESTE="true"
